APP_NAME=Accent-Musique
APP_ENV=dev
BASE_URL=http://localhost/accent_musique/public

DB_HOST=127.0.0.1
DB_NAME=accent_musique
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Configuration SMTP / E-mail
# Exemples :
# Mailpit / Mailhog (local) : MAIL_HOST=127.0.0.1, MAIL_PORT=1025
# Gmail : MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls, MAIL_USERNAME=votre_email, MAIL_PASSWORD=mot_de_passe_application
# Mailtrap : MAIL_HOST=sandbox.smtp.mailtrap.io, MAIL_PORT=2525, MAIL_USERNAME=..., MAIL_PASSWORD=...
MAIL_DRIVER=smtp
MAIL_HOST=accentmusique.fr
MAIL_PORT=465
MAIL_USERNAME=contact@accentmusique.fr
MAIL_PASSWORD=LH)%D]VCW;visq={
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=contact@accentmusique.fr
MAIL_FROM_NAME="Accent-Musique"
ADMIN_EMAIL=accentmusique@gmail.com
# Coordonnées bancaires (virement d'adhésion)
PAYMENT_IBAN=FR76
PAYMENT_BIC=
PAYMENT_HOLDER="Association Accent Musique"
